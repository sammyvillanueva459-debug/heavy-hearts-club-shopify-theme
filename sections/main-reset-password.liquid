<section class="section account-page">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.reset.confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required></div>
      <button type="submit" class="button">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
