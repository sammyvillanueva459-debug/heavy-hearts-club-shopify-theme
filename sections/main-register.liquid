<section class="section account-page">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}"></div>
      <div class="field"><label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}"></div>
      <div class="field"><label for="RegisterEmail">{{ 'customer.login.email' | t }}</label><input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="RegisterPassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required></div>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
      <p><a href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a></p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Register" }
{% endschema %}
