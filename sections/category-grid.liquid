<section class="section category-grid">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="category-grid__list category-grid__list--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li class="category-tile" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.collections_url }}" class="category-tile__link">
            <span class="category-tile__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="category-tile__label">{{ block.settings.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category photography",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Department" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hoodies" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category photography",
      "blocks": [
        { "type": "tile", "settings": { "title": "Men" } },
        { "type": "tile", "settings": { "title": "Women" } },
        { "type": "tile", "settings": { "title": "Kids" } }
      ]
    }
  ]
}
{% endschema %}
