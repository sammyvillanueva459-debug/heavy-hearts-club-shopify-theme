{%- paginate search.results by 24 -%}
<section class="section search-page">
  <div class="page-width">
    <h1 class="page-title">{{ 'search.title' | t }}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchPage">{{ 'general.search.title' | t }}</label>
      <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="empty-state">{{ 'search.no_results_for' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="collection__count">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
        <ul class="product-grid product-grid--4" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <article class="search-result">
                  <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                  <p>{{ item.content | strip_html | truncate: 140 }}</p>
                </article>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results"
}
{% endschema %}
