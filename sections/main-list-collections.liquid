<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ 'collection.all_collections' | t }}</h1>
    <ul class="category-grid__list category-grid__list--3" role="list">
      {%- for collection in collections -%}
        <li class="category-tile">
          <a class="category-tile__link" href="{{ collection.url }}">
            <span class="category-tile__media">
              {%- assign img = collection.featured_image | default: collection.products.first.featured_image -%}
              {%- if img != blank -%}
                {{ img | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="category-tile__label">{{ collection.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection list page"
}
{% endschema %}
