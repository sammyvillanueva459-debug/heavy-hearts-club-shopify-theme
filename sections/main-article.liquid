<article class="section">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ article.title | escape }}</h1>
    <p class="article-card__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time></p>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 990px) 760px, 100vw', alt: article.image.alt }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a class="link-arrow" href="{{ blog.url }}">{{ 'blog.back' | t }}</a>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
