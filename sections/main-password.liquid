<section class="section password-page">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}
    {% render 'newsletter-form', id: 'password' %}
    {%- form 'storefront_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">{{ 'general.password.label' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password">
      </div>
      <button type="submit" class="button">{{ 'general.password.enter' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page" }
{% endschema %}
