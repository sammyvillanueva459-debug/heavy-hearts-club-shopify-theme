{%- paginate blog.articles by 12 -%}
<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ blog.title | escape }}</h1>
    <ul class="product-grid product-grid--3" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card">
          {%- if article.image -%}
            <a href="{{ article.url }}">{{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt }}</a>
          {%- endif -%}
          <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          <p class="article-card__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time></p>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog posts" }
{% endschema %}
