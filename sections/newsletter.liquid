<section class="newsletter section" style="--section-pad: {{ section.settings.padding }}px;">
  <div class="page-width newsletter__inner">
    <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {% render 'newsletter-form', id: section.id %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Club" },
    { "type": "text", "id": "text", "label": "Text", "default": "Be first to hear about drops, restocks and offers." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 20, "max": 120, "step": 10, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
