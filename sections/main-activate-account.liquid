<section class="section account-page">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'customer.activate.title' | t }}</h1>
    {%- form 'activate_customer_password', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActivatePassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ActivatePasswordConfirm">{{ 'customer.reset.confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required></div>
      <button type="submit" name="action" value="activate" class="button">{{ 'customer.activate.submit' | t }}</button>
      <button type="submit" name="action" value="decline" class="button button--secondary">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account" }
{% endschema %}
