<section class="section rich-text">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your brand story.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
