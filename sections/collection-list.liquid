<section class="section collection-list">
  <div class="page-width">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      <a class="link-arrow" href="{{ routes.collections_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <ul class="category-grid__list category-grid__list--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <li class="category-tile" {{ block.shopify_attributes }}>
          <a class="category-tile__link" href="{{ collection.url | default: routes.collections_url }}">
            <span class="category-tile__media">
              {%- assign img = collection.featured_image | default: collection.products.first.featured_image -%}
              {%- if img != blank -%}
                {{ img | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="category-tile__label">{{ collection.title | default: 'Collection' | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collections" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
