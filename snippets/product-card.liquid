{%- comment -%}
  Product card used in grids, search and sliders.
  Accepts:
  - product: {Object} product
  - lazy: {Boolean} lazy load the image (default true)
{%- endcomment -%}
{%- assign color_names = settings.color_option_names | downcase | remove: ' ' | split: ',' -%}
{%- assign color_count = 0 -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name = option.name | downcase | remove: ' ' -%}
  {%- if color_names contains option_name -%}
    {%- assign color_count = option.values.size -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}" aria-hidden="true" tabindex="-1">
    {%- if product.featured_media -%}
      <img
        class="product-card__image"
        src="{{ product.featured_media | image_url: width: 600 }}"
        srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 450 }} 450w, {{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 900 }} 900w"
        sizes="(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw"
        alt=""
        width="{{ product.featured_media.preview_image.width }}"
        height="{{ product.featured_media.preview_image.height }}"
        {% if lazy != false %}loading="lazy"{% endif %}
      >
      {%- if settings.show_secondary_image_on_hover and product.media.size > 1 -%}
        <img
          class="product-card__image product-card__image--secondary"
          src="{{ product.media[1].preview_image | image_url: width: 600 }}"
          alt=""
          width="{{ product.media[1].preview_image.width }}"
          height="{{ product.media[1].preview_image.height }}"
          loading="lazy"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge--sale">{{ 'products.product.sale' | t }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    {%- if color_count > 1 -%}
      <p class="product-card__colors">{{ 'products.product.colors_count' | t: count: color_count }}</p>
    {%- endif -%}
    {% render 'price', product: product %}
  </div>
</article>
